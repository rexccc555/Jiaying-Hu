generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(cuid())
  email            String      @unique
  passwordHash     String
  /** 昵称；全局唯一由迁移中的 LOWER(TRIM(name)) 唯一索引保证（不区分大小写、忽略首尾空格） */
  name             String
  phone            String?
  /** 可选：出发前/行程规划相关邮件提醒 */
  planningReminderOptIn Boolean @default(false)
  /** 可选：玩法简报、精选优惠等订阅类邮件 */
  productNewsOptIn      Boolean @default(false)
  createdAt        DateTime    @default(now())
  savedTrips       SavedTrip[]
  xhsBinding       XhsBinding?
}

model SavedTrip {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale    String
  payload   String
  createdAt DateTime @default(now())

  @@index([userId])
}

/** 人生重新开服：观众投票（每轮每个访客一票） */
model QuestVote {
  id        String   @id @default(cuid())
  roundId   String
  optionId  String
  voterId   String
  ipHash    String
  createdAt DateTime @default(now())

  @@unique([roundId, voterId])
  @@index([roundId, ipHash])
}

/** 人生重新开服：观众投稿任务（人工筛选后进入投票池） */
model QuestSubmission {
  id         String    @id @default(cuid())
  text       String
  nickname   String?
  ipHash     String
  /** pending | approved | rejected */
  status     String    @default("pending")
  /** 审核后用于投票展示的字段 */
  title      String?
  zone       String?
  difficulty Int?
  xp         Int?
  desc       String?
  /** 进入某一轮投票时填写 */
  roundId    String?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([ipHash, createdAt])
  @@index([roundId])
}

/** 人生重新开服：后台可改的站点设置（如当前投票轮） */
model GameSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/** 小红书云端代发：加密后的创作者会话（由 Worker 写入） */
model XhsBinding {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /** AES-GCM 密文：Worker 会话目录或 cookie JSON */
  encryptedSession String
  status           String   @default("active")
  label            String?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())
}
