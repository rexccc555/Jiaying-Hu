# 本地联调（不影响 Netlify）：复制 env.local.template → .env.local，或运行 npm run env:local
# 详见 env.local.template。Prisma 默认不读 .env.local，请用：npm run db:migrate / db:push / db:studio

# 可选：填写后由 OpenAI 组合行程（优先 POI 目录；也可输出带坐标的 customPlace 非库内站点，服务端会校验范围）。
# 走朋友的中转 / Adam 时：把对方给的「令牌」仍填在 OPENAI_API_KEY（变量名不用改），BASE_URL 指向对方网关。
OPENAI_API_KEY=
# 可选；不设时默认依次尝试 gpt-5.4、gpt-4o-mini（适配常见中转）。可写多个候选（逗号或竖线），遇 403/无权模型会自动换下一个：
# OPENAI_MODEL=gpt-5.4,gpt-4o,gpt-4o-mini
OPENAI_MODEL=gpt-5.4
# 可选：OpenAI 兼容 API 的根地址（须含 /v1，与官方 SDK 一致）。不设则默认 https://api.openai.com/v1
# 例：Netlify / 自建 Adam 网关
# OPENAI_BASE_URL=https://api.adamchatbot.chat/v1
OPENAI_BASE_URL=
# 部分 OpenAI 兼容网关不支持 response_format=json_object；若生成一直失败可设为 0
# OPENAI_RESPONSE_FORMAT_JSON=0
# 设为 1 时，结果页 meta 会带 upstreamDebug（HTTP 状态/错误摘要或 empty_itinerary_from_model），便于对照网关日志
# OPENAI_DEBUG=1
# 单次请求超时（毫秒），默认 120000
# OPENAI_TIMEOUT_MS=120000
# 设为 1 时跳过对每个 customPlace.officialUrl 的可达性探测（减轻 Netlify 函数超时导致整段失败）
# OPENAI_SKIP_OFFICIAL_URL_CHECK=1
# 覆盖默认 temperature（不设时 gpt-5* 系列默认 1，其余 0.7）
# OPENAI_TEMPERATURE=1

# 规范站点根 URL（无末尾斜杠），用于部分页面的 canonical 等（与 public/sitemap.xml 无自动联动）
# NEXT_PUBLIC_SITE_URL=https://takeadayoff.co.nz
# 根路径 sitemap / robots 使用 public/sitemap.xml 与 public/robots.txt（静态，最稳）；换主域名时请手改这两份文件里的 URL。

# 可选：访问量统计（二选一或都配；不配则完全不加载脚本）
# Plausible：域名填你统计后台里绑定的站点域
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=takeadayoff.co.nz
# 自托管 Plausible 时改脚本地址，不配则默认 https://plausible.io/js/script.js
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# Google Analytics 4
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Prisma / 注册与登录（PostgreSQL；与 env.local.template 一致，勿提交真实连接串）
# DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Prisma CLI 不自动读 .env.local：本地迁移请用 npm run db:migrate；对已存在的 Neon 库应用迁移用 npm run db:deploy（等同 prisma migrate deploy）。
DATABASE_URL=

# 登录 Cookie 签名（至少 16 字符；生产必填）
SESSION_SECRET=

# 小红书云端发布 Worker（Railway 等）。不配则 /xhs 仍可生成文案，但无法扫码绑定/代发。
# XHS_WORKER_URL=https://your-worker.up.railway.app
# XHS_WORKER_SECRET=long-shared-secret
# 加密绑定会话用（建议独立密钥；不配则回退 SESSION_SECRET）
# XHS_SESSION_CRYPTO_KEY=

# 事务邮件（Resend：https://resend.com）注册成功后发送欢迎邮件；不配 key 则跳过发送（开发环境会在控制台提示）
# RESEND_API_KEY=re_xxxxxxxx
# 发件人（须在 Resend 验证域名；测试可用 Resend 提供的 onboarding@resend.dev）
# EMAIL_FROM=Take a Day Off <hello@takeadayoff.co.nz>
